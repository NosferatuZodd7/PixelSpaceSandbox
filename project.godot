; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PixelSpaceSandbox"
config/description="A lightweight 2D pixel-art universe sandbox god game."
config/version="0.0.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043137256, 0.039215688, 0.13333334, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

App="*res://src/core/app.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[internationalization]

locale/translations=PackedStringArray("res://locale/ui.en.translation", "res://locale/ui.pt_PT.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/driver.windows="opengl3"
gl_compatibility/fallback_to_angle=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.043137256, 0.039215688, 0.13333334, 1)
