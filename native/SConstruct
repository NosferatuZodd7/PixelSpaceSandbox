#!/usr/bin/env python
# Builds the native gravity kernel, a GDExtension, with godot-cpp (branch 4.5,
# which also runs on later Godot 4 versions). From this folder:
#
#   scons platform=linux target=template_release godot_cpp=/path/to/godot-cpp
#   scons platform=windows target=template_release godot_cpp=/path/to/godot-cpp
#
# One optimised library per platform serves the editor and both export kinds.
import os

godot_cpp = ARGUMENTS.get("godot_cpp", os.environ.get("GODOT_CPP", ""))
if not godot_cpp:
    # Kept outside the project: Godot would otherwise find godot-cpp's own
    # example extension and try to load it.
    print("Pass godot_cpp=/path/to/godot-cpp (or set GODOT_CPP), a checkout of godot-cpp branch 4.5 outside this project.")
    Exit(1)
ARGUMENTS.setdefault("build_profile", os.path.abspath("build_profile.json"))
env = SConscript(os.path.join(godot_cpp, "SConstruct"))

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
name = "bin/libpixelspace.{}.{}{}".format(env["platform"], env["arch"], env["SHLIBSUFFIX"])
library = env.SharedLibrary(name, source=sources)
Default(library)
